# ─── Docker local ───
# Copiar a .env :  Copy-Item .env.example .env
# Generar cada valor por cliente, NO reutilizar entre instalaciones:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_PASSWORD=CAMBIAR-clave-postgres-del-cliente
JWT_SECRET=CAMBIAR-generar-con-el-comando-de-arriba-min-64-chars-hex
ADMIN_PASSWORD=CAMBIAR-clave-inicial-del-admin-min-8-caracteres

# SMTP opcional (puede quedar vacío en local)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
