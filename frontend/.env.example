# ─── Frontend local ───
# En desarrollo con `npm run dev` NO necesitas nada:
# vite.config.js ya hace proxy de /api -> http://localhost:3001
# Solo define VITE_API_URL si sirves el build sin nginx o usas otro puerto:
# VITE_API_URL=http://localhost:3001

# ─── Si quieres seguir viendo el proyecto en Vercel pero con datos LOCALES ───
# Vercel NO puede llegar a localhost. Opciones:
# 1) Modo 100% local (recomendado): no uses Vercel, abre http://localhost
# 2) Modo híbrido demo: expón tu backend con un túnel y pon aquí la URL pública:
# VITE_API_URL=https://tu-tunel.trycloudflare.com
