DATABASE_URL="postgresql://postgres:password@localhost:5432/parqueadero_db"
PORT=3001
JWT_SECRET=generate_with_node_e_console_log_require_crypto_random_bytes_32_toString_hex
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin seed password (requerido para seed.js, min 8 caracteres)
ADMIN_PASSWORD=admin123

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
SMTP_FROM_NAME=ParkAdmin
SMTP_FROM=tu-correo@gmail.com
FRONTEND_URL=http://localhost:5173

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
